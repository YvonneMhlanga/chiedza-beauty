# URL of the chiedza-backend API. Defaults to http://localhost:5000/api if unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google sign-in ("Continue with Google" on the login/register pages).
# This is the ONLY line you need for Google sign-up to work.
#
# 1. Open https://console.cloud.google.com/apis/credentials
# 2. + Create Credentials  ->  OAuth client ID
# 3. Application type: "Web application"
# 4. Authorised JavaScript origins  ->  Add URI  ->  http://localhost:3000
#    (add http://localhost:3100 too if you run the dev server on that port)
# 5. Create, then copy the "Client ID" (ends in .apps.googleusercontent.com) below
# 6. Save this file as .env.local (not .env.local.example) and restart `npm run dev`
#
# Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase (optional / not currently used by the app)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
