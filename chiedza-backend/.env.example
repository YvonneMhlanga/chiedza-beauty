# Copy to .env and fill in. Do NOT commit .env.
PORT=5000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# ── Persistence (optional) ────────────────────────────────────────────────
# Leave BOTH blank for local dev: the app uses SQLite (chiedza.db) + the local
# uploads/ folder and needs no setup.

# Postgres connection string. When set, the app uses Postgres instead of SQLite.
# Neon (free): https://neon.tech  ->  copy the "postgresql://..." connection string.
DATABASE_URL=

# Image storage:
#   - default with DATABASE_URL set: images are stored in Postgres (uploads table)
#     and served from /api/uploads/file/:id  — no extra service needed.
#   - default without DATABASE_URL: local uploads/ folder.
#   - set CLOUDINARY_URL to use Cloudinary instead (cloudinary://key:secret@cloud).
# Force a mode with IMAGE_STORE = db | disk | cloudinary
CLOUDINARY_URL=
# IMAGE_STORE=

# ── Google sign-in (optional) ─────────────────────────────────────────────
# If blank, the backend trusts the client id the frontend was built with
# (NEXT_PUBLIC_GOOGLE_CLIENT_ID) and still fully verifies the Google token.
GOOGLE_CLIENT_ID=
