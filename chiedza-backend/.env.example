# Copy to .env and fill in. Do NOT commit .env.
PORT=5000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# Google sign-in (OPTIONAL). If blank, the backend trusts the client id the
# frontend was built with (NEXT_PUBLIC_GOOGLE_CLIENT_ID) and still fully
# verifies the Google token. Set this only to pin it server-side.
GOOGLE_CLIENT_ID=
